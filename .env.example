# MindScroll configuration (copy to .env.local — see README)
#
# Default is "mock": a deterministic, offline generator that needs NO keys and costs $0.
# Leave it as "mock" to run the whole app with zero setup.
AI_PROVIDER=mock

# To go live, set AI_PROVIDER to one of gemini | groq | openai and paste ONE key.
# All three have free tiers (Gemini and Groq need no credit card).
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Optional model override (defaults are sensible):
# gemini-2.0-flash | llama-3.3-70b-versatile | gpt-4o-mini
AI_MODEL=

# YouTube search (optional — enables searching ALL of YouTube by topic).
# Free: Google Cloud → enable "YouTube Data API v3" → create an API key.
YOUTUBE_API_KEY=

# Supabase (optional — production persistence + realtime leaderboards):
SUPABASE_URL=
SUPABASE_ANON_KEY=
